<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:ignore="ContentDescription">

    <!-- DYNAMIC ISLAND TOP BAR: a floating, near-black capsule that holds the launcher name
         and a status lamp. Tapping it morphs the capsule into a wider slab with every quick
         action, tapping again folds it back - see MainMenuFragment.setupDynamicIsland().
         The capsule is in normal layout flow (the panels below are anchored to its bottom),
         so opening it never covers the content underneath. -->
    <LinearLayout
        android:id="@+id/home_top_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:background="@drawable/background_dynamic_island"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Collapsed content: dot + title/subtitle + chevron. The whole row is the toggle. -->
        <LinearLayout
            android:id="@+id/island_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/background_island_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <View
                android:id="@+id/island_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/background_island_dot" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/home_top_bar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/main_top_bar_title"
                    android:textColor="@color/turtle_primary_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_top_bar_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:text="@string/main_top_bar_subtitle"
                    android:textColor="@color/turtle_text_secondary"
                    android:textSize="10sp" />

            </LinearLayout>

            <com.endiq.turtlelauncher.ui.view.AnimatedIconView
                android:id="@+id/island_toggle_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="12dp"
                android:padding="2dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/turtle_text_secondary" />

        </LinearLayout>

        <!-- Expanded content: the quick-action grid. Fixed width so the capsule has a
             defined size to grow into; hidden (GONE) while collapsed. -->
        <LinearLayout
            android:id="@+id/island_expanded"
            android:layout_width="288dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="6dp"
                android:background="@color/island_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.endiq.turtlelauncher.ui.view.AnimatedIconButton
                    android:id="@+id/top_bar_account_button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_island_action"
                    android:contentDescription="@string/main_nav_account"
                    android:padding="11dp"
                    android:src="@drawable/ic_help"
                    android:tint="@color/turtle_text_secondary" />

                <com.endiq.turtlelauncher.ui.view.AnimatedIconButton
                    android:id="@+id/top_bar_storage_button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_island_action"
                    android:contentDescription="@string/main_nav_files"
                    android:padding="11dp"
                    android:src="@drawable/ic_folder"
                    android:tint="@color/turtle_text_secondary" />

                <com.endiq.turtlelauncher.ui.view.AnimatedIconButton
                    android:id="@+id/top_bar_download_button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_island_action"
                    android:contentDescription="@string/main_nav_download"
                    android:padding="11dp"
                    android:src="@drawable/ic_download"
                    android:tint="@color/turtle_text_secondary" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1">

                    <com.endiq.turtlelauncher.ui.view.AnimatedIconButton
                        android:id="@+id/top_bar_tasks_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/background_island_action"
                        android:contentDescription="@string/main_nav_tasks"
                        android:padding="11dp"
                        android:src="@drawable/ic_tasks"
                        android:tint="@color/turtle_text_secondary" />

                    <TextView
                        android:id="@+id/top_bar_tasks_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/background_task_badge"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="14dp"
                        android:minHeight="14dp"
                        android:paddingHorizontal="3dp"
                        android:textColor="@color/turtle_text_on_accent"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="2" />

                </FrameLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.endiq.turtlelauncher.ui.view.AnimatedIconButton
                    android:id="@+id/top_bar_music_button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_island_action"
                    android:contentDescription="@string/music_title"
                    android:padding="11dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="@color/turtle_text_secondary" />

                <com.endiq.turtlelauncher.ui.view.AnimatedIconButton
                    android:id="@+id/top_bar_cursor_button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_island_action"
                    android:contentDescription="@string/main_nav_cursor"
                    android:padding="11dp"
                    android:src="@drawable/ic_cursor"
                    android:tint="@color/turtle_text_secondary" />

                <com.endiq.turtlelauncher.ui.view.AnimatedIconButton
                    android:id="@+id/top_bar_ai_button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_island_action"
                    android:contentDescription="@string/main_nav_assistant"
                    android:padding="11dp"
                    android:src="@drawable/ic_ai_assistant"
                    android:tint="@color/turtle_text_secondary" />

                <com.endiq.turtlelauncher.ui.view.AnimatedIconButton
                    android:id="@+id/top_bar_settings_button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_island_action"
                    android:contentDescription="@string/main_nav_settings"
                    android:padding="11dp"
                    android:src="@drawable/ic_menu_settings"
                    android:tint="@color/turtle_text_secondary" />

                <!-- Keeps the second row on the same five-column grid as the first. -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- LEFT PANEL: no surface of its own. The wallpaper/video runs edge to edge and the
         quick actions float on it as individual glass tiles; a full-bleed block here used
         to paint a black rectangle over the clip. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/play_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_top_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/launcher_content_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/launcher_footer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Quick actions rail: small squares, scrollable, left-docked -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/quick_actions_rail"
                android:layout_width="52dp"
                android:layout_height="0dp"
                android:scrollbars="none"
                android:paddingTop="@dimen/space_xs"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_xs">

                    <!-- Browse Mods -->
                    <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                        android:id="@+id/about_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="@dimen/space_xs"
                        android:background="@drawable/background_grid_card"
                        app:ripple_for_relative="true">
                        <com.endiq.turtlelauncher.ui.view.AnimatedIconView
                            android:id="@+id/about_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_puzzle_piece"
                            android:tint="@color/accent_primary"/>
                        <TextView
                            android:id="@+id/about_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/turtle_primary_text"/>
                    </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                    <!-- Custom Controls -->
                    <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                        android:id="@+id/custom_control_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="@dimen/space_xs"
                        android:background="@drawable/background_grid_card"
                        app:ripple_for_relative="true">
                        <com.endiq.turtlelauncher.ui.view.AnimatedIconView
                            android:id="@+id/custom_control_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_gamepad"
                            android:tint="@color/accent_primary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:text="@string/custom_control_title"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/turtle_primary_text"/>
                    </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                    <!-- Install JAR -->
                    <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                        android:id="@+id/install_jar_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="@dimen/space_xs"
                        android:background="@drawable/background_grid_card"
                        app:ripple_for_relative="true">
                        <com.endiq.turtlelauncher.ui.view.AnimatedIconView
                            android:id="@+id/install_jar_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_java"
                            android:tint="@color/accent_primary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:text="@string/main_install_jar_file"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/turtle_primary_text"/>
                    </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                    <!-- Friends (unified Discord + Turtle friends, DMs, parties and voice) -->
                    <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                        android:id="@+id/friends_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="@dimen/space_xs"
                        android:background="@drawable/background_grid_card"
                        app:ripple_for_relative="true">
                        <com.endiq.turtlelauncher.ui.view.AnimatedIconView
                            android:id="@+id/friends_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_friends_network"
                            android:tint="@color/accent_primary"
                            android:contentDescription="@string/social_title"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:text="@string/social_title"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/turtle_primary_text"/>
                    </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                    <!-- Share Logs -->
                    <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                        android:id="@+id/share_logs_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="@dimen/space_xs"
                        android:background="@drawable/background_grid_card"
                        app:ripple_for_relative="true">
                        <com.endiq.turtlelauncher.ui.view.AnimatedIconView
                            android:id="@+id/share_logs_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_share"
                            android:tint="@color/accent_primary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:text="@string/main_share_logs"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/turtle_primary_text"/>
                    </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                    <!-- Modpack Importer -->
                    <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                        android:id="@+id/modpack_import_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="@dimen/space_xs"
                        android:background="@drawable/background_grid_card"
                        app:ripple_for_relative="true">
                        <com.endiq.turtlelauncher.ui.view.AnimatedIconView
                            android:id="@+id/modpack_import_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_zip"
                            android:tint="@color/accent_primary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:text="@string/main_modpack_import"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/turtle_primary_text"/>
                    </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/launcher_menu"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scrollbars="none"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/quick_actions_rail"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_m"
                    android:paddingBottom="@dimen/space_l">

                    <!-- Feature plugins (populated at runtime by MainMenuFragment - see
                         FeaturePluginManager; empty/GONE unless a feature-plugin app is installed) -->
                    <LinearLayout
                        android:id="@+id/feature_plugins_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:ignore="UselessParent"/>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Footer -->
        <LinearLayout
            android:id="@+id/launcher_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingVertical="@dimen/space_s"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/footer_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/turtle_text_primary"
                tools:text="TurtleLauncher"/>

            <TextView
                android:id="@+id/footer_version_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_s"
                android:textSize="12sp"
                android:textColor="@color/turtle_text_secondary"
                tools:text="v1.0.0.0"/>

            <com.endiq.turtlelauncher.ui.view.AnimatedIconButton
                android:id="@+id/footer_github_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_git_branch"
                android:padding="6dp"
                android:tint="@color/turtle_text_secondary"
                android:contentDescription="GitHub"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- RIGHT PANEL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/play_layout"
        android:layout_width="200dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_s"
        android:layout_marginBottom="@dimen/space_s"
        android:background="@drawable/background_island_panel"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingTop="@dimen/space_m"
        android:paddingBottom="@dimen/space_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_top_bar">

        <!-- Optional picture or looping clip chosen by the user, shown above the version card.
             The small button in the header row below picks or clears it (MainMenuFragment); the
             empty state is only a translucent outline, never a dark block over the video. -->
        <FrameLayout
            android:id="@+id/panel_media_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/space_s"
            app:layout_constraintBottom_toTopOf="@+id/play_buttons_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_min="76dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/panel_media_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/background_panel_media"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:ignore="ContentDescription"/>

            <com.endiq.turtlelauncher.ui.view.BackgroundVideoView
                android:id="@+id/panel_media_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                tools:ignore="ContentDescription"/>

            <LinearLayout
                android:id="@+id/panel_media_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/background_panel_media"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_s">

                <com.endiq.turtlelauncher.ui.view.AnimatedIconView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:alpha="0.75"
                    android:src="@drawable/ic_add"
                    android:tint="@color/accent_primary"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/panel_media_hint"
                    android:textColor="@color/turtle_text_secondary"
                    android:textSize="10sp"/>
            </LinearLayout>

        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/play_buttons_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- SELECTED VERSION header -->
            <TextView
                android:id="@+id/selected_version_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/main_section_selected_version"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/turtle_text_secondary"
                android:letterSpacing="0.08"
                android:layout_marginBottom="@dimen/space_s"
                app:layout_constraintBottom_toTopOf="@+id/version"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/panel_media_pick_button"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- Small picker for the media slot above: picture, video or clear it. -->
            <com.endiq.turtlelauncher.ui.view.AnimatedIconButton
                android:id="@+id/panel_media_pick_button"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/background_icon_chip"
                android:contentDescription="@string/panel_media_pick_title"
                android:padding="6dp"
                android:src="@drawable/ic_add"
                android:tint="@color/accent_primary"
                app:layout_constraintBottom_toBottomOf="@id/selected_version_header"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/selected_version_header"/>

            <!-- Version selector -->
            <com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/version"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginBottom="@dimen/space_s"
                android:background="@drawable/background_item"
                android:paddingHorizontal="10dp"
                app:layout_constraintBottom_toTopOf="@+id/play_button"
                app:layout_constraintEnd_toStartOf="@+id/manager_profile_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/selected_version_header">
                <com.endiq.turtlelauncher.ui.view.AnimatedIconView
                    android:id="@+id/version_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_minecraft"/>
                <com.endiq.turtlelauncher.ui.view.AnimatedIconView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="@color/turtle_text_secondary"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/version_icon"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/version_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/turtle_primary_text"
                        android:text="@string/version_no_versions"/>
                    <TextView
                        android:id="@+id/version_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="11sp"
                        android:textColor="@color/turtle_text_secondary"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.endiq.turtlelauncher.ui.layout.AnimRelativeLayout>

            <com.endiq.turtlelauncher.ui.view.AnimatedIconButton
                android:id="@+id/manager_profile_button"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="@dimen/space_s"
                android:background="@drawable/background_item"
                android:padding="12dp"
                android:src="@drawable/ic_setting"
                android:tint="@color/turtle_text_secondary"
                app:layout_constraintBottom_toTopOf="@+id/play_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/version"/>

            <com.endiq.turtlelauncher.ui.view.AnimButton
                android:id="@+id/play_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_launch_button"
                android:text="@string/main_launch"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/turtle_text_on_accent"
                android:letterSpacing="0.1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
