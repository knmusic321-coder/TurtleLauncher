<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/game_notice_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    <!-- Header row -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/_10sdp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/game_notice_title"
            android:textColor="@color/turtle_success"
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/close_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="@color/turtle_error"
            android:textSize="@dimen/_18ssp"
            android:padding="@dimen/_4sdp"
            android:background="?android:attr/selectableItemBackgroundBorderless"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <TextView
        android:id="@+id/notice_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/accent_primary"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold"
        android:background="@color/turtle_accent_ripple"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        tools:text="v5"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/notice_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/notice_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/notice_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:gravity="center"
        android:paddingVertical="@dimen/_10sdp"
        android:background="@color/turtle_accent_ripple"
        android:text="@string/game_notice_close"
        android:textColor="@color/accent_primary"
        android:textStyle="bold"
        android:textSize="@dimen/_14ssp"/>

</androidx.appcompat.widget.LinearLayoutCompat>
