<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="padding_tiny">@dimen/_2sdp</dimen>
    <dimen name="padding_small">@dimen/_4sdp</dimen>
    <dimen name="padding_moderate">@dimen/_8sdp</dimen>
    <dimen name="padding_large">@dimen/_15sdp</dimen>
    <dimen name="padding_extra_large">@dimen/_20sdp</dimen>
    <dimen name="padding_heavy">@dimen/_25sdp</dimen>
    <dimen name="dialog_min_width">@dimen/_280sdp</dimen>
    <!-- Referenced by PixelEditorDialog and dialog_control_button_setting; same 4dp step as
         padding_small, kept as an alias so the scale above stays the single source of truth. -->
    <dimen name="padding_medium">@dimen/padding_small</dimen>

    <!-- Miuix Design System Corner Radii & Elevations -->
    <!-- One radius ladder, proportional to the surface's own size: a chip is 10, an item 14, a
         card 20, a floating panel 24, a dialog 30, the home island 32. Keeping the steps
         proportional is what stops a large sheet from reading as a small card that was stretched.
         Advanced appearance scales the code-built surfaces on top of these. -->
    <dimen name="radius_card">20dp</dimen>
    <dimen name="radius_button">18dp</dimen>
    <dimen name="radius_dialog">30dp</dimen>
    <dimen name="radius_pill">999dp</dimen>
    <dimen name="elevation_card">0dp</dimen>
    <dimen name="elevation_dialog">12dp</dimen>
    <dimen name="stroke_subtle">1dp</dimen>

    <!-- Corner radii still referenced by the list-item / edit-box / glass-card selectors. -->
    <dimen name="radius_chip">10dp</dimen>
    <dimen name="radius_item">14dp</dimen>
    <dimen name="radius_panel">24dp</dimen>
    <!-- Dynamic island: the outer capsule and the tap targets inside it. -->
    <dimen name="radius_island">32dp</dimen>
    <dimen name="radius_island_inner">24dp</dimen>

    <!-- 4dp baseline spacing scale, referenced by the gallery and settings layouts. -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_s">8dp</dimen>
    <dimen name="space_m">12dp</dimen>
    <dimen name="space_l">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>
</resources>
