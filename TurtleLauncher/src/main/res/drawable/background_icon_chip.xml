<?xml version="1.0" encoding="utf-8"?>
<!-- Icon chip: accent-tinted glass instead of a solid grey block, so the small glyph in
     front of each settings card carries the palette accent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_chip" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
    <corners android:radius="@dimen/radius_chip" />
</shape>
