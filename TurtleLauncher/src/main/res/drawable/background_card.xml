<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted card surface: translucent fill plus a hairline highlight, so cards read as
     panes of glass laid over the wallpaper instead of opaque blocks. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
    <corners android:radius="@dimen/radius_card" />
</shape>
