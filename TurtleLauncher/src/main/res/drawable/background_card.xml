<?xml version="1.0" encoding="utf-8"?>
<!-- Card surface: a frosted pane with a vertical gradient (brighter at the top where the
     light lands, denser at the bottom) and a hairline stroke instead of a drop shadow.
     One shape drawable - not a layer list - so callers that mutate the drawable's alpha for
     page transparency keep working. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/glass_surface"
        android:startColor="@color/glass_surface_raised"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
    <corners android:radius="@dimen/radius_card" />
</shape>
