<?xml version="1.0" encoding="utf-8"?>
<!-- Panel behind the in-game menu's group icons and feature pages: a soft, very rounded
     "liquid" surface with a light sheen along its top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_translucent" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00FFFFFF"
                android:startColor="#1AFFFFFF" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</layer-list>
