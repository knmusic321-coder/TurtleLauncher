<?xml version="1.0" encoding="utf-8"?>
<!-- Dynamic island surface: a very dark, nearly black capsule with a hairline accent
     stroke and a soft top light, so it reads as a floating piece of hardware over the
     launcher background. The radius is smaller than half of the expanded height, which
     is what makes the same drawable a full pill when collapsed (see fragment_launcher)
     and a large rounded slab when it opens. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/island_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/island_stroke" />
            <corners android:radius="@dimen/radius_island" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="#1FFFFFFF" />
            <corners android:radius="@dimen/radius_island" />
        </shape>
    </item>
</layer-list>
