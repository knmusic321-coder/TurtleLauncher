<?xml version="1.0" encoding="utf-8"?>
<!-- Solid page surface for the launcher's own screens.

     It is a shape drawable rather than a plain @color so PageTransparency can mutate its
     alpha per view: at 100% the page is the usual near-black, at 0% it is completely
     transparent and the wallpaper or background video shows through. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0D0D0D" />
</shape>
