<?xml version="1.0" encoding="utf-8"?>
<!-- Page surface for the launcher's own screens.

     This used to be a solid #0D0D0D sheet, which is what showed up as a black board over
     the background video. It is now a translucent glass gradient: the clip keeps playing
     through the page, and only a light tint is added so text stays readable.

     It stays a shape drawable (not a plain @color) so PageTransparency can mutate its
     alpha per view: at 100% the tint is fully applied, at 0% the page is completely
     transparent and only the content is left floating over the video. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/glass_page_bottom"
        android:startColor="@color/glass_page_top"
        android:type="linear" />
</shape>
