<?xml version="1.0" encoding="utf-8"?>
<!-- Floating glass panel for the right-hand launch column: same visual family as the
     dynamic island, so the whole home screen reads as layered surfaces instead of full-bleed
     blocks. The gradient is brightest at the top, where the light would hit the material. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/island_panel"
        android:startColor="#D91A1D18"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/island_stroke_soft" />
    <corners android:radius="@dimen/radius_panel" />
</shape>
