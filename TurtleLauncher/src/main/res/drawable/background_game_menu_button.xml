<?xml version="1.0" encoding="utf-8"?>
<!-- Floating in-game menu button: a small glass chip with an accent edge so it is easy to
     find over a bright game scene without covering it with a dark square. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_surface_raised" />
    <stroke
        android:width="1dp"
        android:color="@color/island_stroke" />
    <corners android:radius="16dp" />
</shape>
