<?xml version="1.0" encoding="utf-8"?>
<!-- Fine frosted sheet laid over the wallpaper/video when the glass effect is on.
     Kept intentionally faint: it should read as light passing through glass, not as a
     grey wash over the picture. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#00FFFFFF"
        android:startColor="#1AFFFFFF"
        android:type="linear" />
</shape>
