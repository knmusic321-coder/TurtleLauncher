<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted sheet laid over the wallpaper/video when the glass effect is on.

     The backdrop is never blurred any more: a blurred video made the whole home screen look
     out of focus, so this is only a very light sheen on top of a sharp picture. It is
     strongest behind the island and the headers and fades to nothing at the bottom, which is
     what real glass does along its edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#0AFFFFFF"
        android:endColor="#00FFFFFF"
        android:startColor="#1AFFFFFF"
        android:type="linear" />
</shape>
