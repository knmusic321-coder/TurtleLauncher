<?xml version="1.0" encoding="utf-8"?>
<!-- The "liquid island" rail behind the in-game menu's group icons: one fluid capsule with a
     light top sheen, instead of the old flat tab strip. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00FFFFFF"
                android:startColor="#22FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
