<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-action tile: a glass square one radius step below a card, with an accent-tinted
     press wash so the rail answers the finger immediately. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/island_stroke_soft" />
            <corners android:radius="@dimen/radius_item" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_surface_raised" />
            <stroke
                android:width="1dp"
                android:color="@color/island_stroke" />
            <corners android:radius="@dimen/radius_item" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_surface_raised" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
            <corners android:radius="@dimen/radius_item" />
        </shape>
    </item>
</selector>
