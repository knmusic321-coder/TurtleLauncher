<?xml version="1.0" encoding="utf-8"?>
<!-- The screen being covered steps back a third of its width and dims a little, so the
     two screens read as two layers instead of one sliding sheet. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/nav_motion">
    <translate
        android:fromXDelta="0"
        android:toXDelta="-28%p"
        android:duration="320" />
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.75"
        android:duration="320" />
</set>
