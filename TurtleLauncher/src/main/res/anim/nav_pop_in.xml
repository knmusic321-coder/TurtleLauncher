<?xml version="1.0" encoding="utf-8"?>
<!-- Back: the screen underneath returns from where it was pushed aside. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/nav_motion">
    <translate
        android:fromXDelta="-28%p"
        android:toXDelta="0"
        android:duration="300" />
    <alpha
        android:fromAlpha="0.75"
        android:toAlpha="1.0"
        android:duration="300" />
</set>
